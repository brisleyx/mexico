# Crie um projeto Supabase SÓ para o LaMantra (não reuse o banco de outro produto).
# Sem VITE_SUPABASE_* o app roda em modo demo (dados no navegador).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# true = simula SPEI no browser. false = Edge Functions + Pagnovo.
VITE_PAGANOVO_MOCK=true

# Pixel do TikTok (público, vai no bundle). Sem isto o ttq.page/InitiateCheckout/CompletePayment não disparam.
VITE_TIKTOK_PIXEL_ID=

# Pixel da Utmify (Integrações → Pixel). Opcional se o TikTok Ads já está ligado no dashboard da Utmify.
VITE_UTMIFY_PIXEL_ID=

# NUNCA coloque a secret da Pagnovo nem o token da Utmify aqui, nem com prefixo VITE_.
# Configure no Dashboard do Supabase → Edge Functions → Secrets:
#   PAGNOVO_SECRET_KEY=
#   PAGNOVO_WEBHOOK_SECRET=
#   PAGNOVO_RESPONSIBLE_DOCUMENT=
#   PAGNOVO_RESPONSIBLE_EXTERNAL_ID=  (id estável do responsável na Pagnovo; default = CNPJ)
#   UTMIFY_API_TOKEN=                 (Integrações → Webhooks → Credenciais de API)
#   TIKTOK_PIXEL_ID=                  (mesmo pixel do VITE_TIKTOK_PIXEL_ID; Events API)
#   TIKTOK_ACCESS_TOKEN=              (Events API do TikTok — nunca com prefixo VITE_)
#   UTMIFY_TEST=true                  (opcional: valida o payload sem gravar a venda)
