# Crie um projeto Supabase SÓ para o LaMantra (não reuse o banco de outro produto).
# Sem VITE_SUPABASE_* o app roda em modo demo (dados no navegador).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# true = simula SPEI no browser. false = Edge Functions + Pagnovo.
VITE_PAGANOVO_MOCK=true

# NUNCA coloque a secret da Pagnovo aqui nem com prefixo VITE_.
# Configure no Dashboard do Supabase → Edge Functions → Secrets:
#   PAGNOVO_SECRET_KEY=
#   PAGNOVO_WEBHOOK_SECRET=
